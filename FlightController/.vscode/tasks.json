{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure FlightController",
            "type": "process",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": ["--preset", "Debug"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:/Users/Neco/AppData/Local/stm32cube/bundles/ninja/1.13.1+st.1/bin;C:/Users/Neco/AppData/Local/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Build FlightController",
            "type": "process",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": ["--build", "--preset", "Debug"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:/Users/Neco/AppData/Local/stm32cube/bundles/ninja/1.13.1+st.1/bin;C:/Users/Neco/AppData/Local/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin;${env:PATH}"
                }
            },
            "dependsOn": "Configure FlightController",
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "飞控烧录 (DAPLink 5MHz)",
            "type": "process",
            "command": "D:/dev/tools/openocd/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "args": [
                "-s", "D:/dev/tools/openocd/xpack-openocd-0.12.0-7/openocd/scripts",
                "-f", "${workspaceFolder}/openocd.cfg",
                "-c", "program {${workspaceFolder}/build/Debug/FlightController.elf} verify reset exit"
            ],
            "dependsOn": "Build FlightController",
            "problemMatcher": []
        },
        {
            "label": "飞控烧录 (ST-Link 10MHz)",
            "type": "process",
            "command": "D:/dev/tools/openocd/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "args": [
                "-s", "D:/dev/tools/openocd/xpack-openocd-0.12.0-7/openocd/scripts",
                "-f", "${workspaceFolder}/openocd-stlink.cfg",
                "-c", "program {${workspaceFolder}/build/Debug/FlightController.elf} verify reset exit"
            ],
            "dependsOn": "Build FlightController",
            "problemMatcher": []
        }
    ]
}
